{
  "name": "@onyxcode/cli",
  "version": "0.1.0",
  "description": "OnyxCode — AI coding agent TUI for the terminal",
  "type": "module",
  "license": "MIT",
  "author": "OnyxCode contributors",
  "homepage": "https://github.com/Reyofficial77/OnyXCode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reyofficial77/OnyXCode.git"
  },
  "bugs": {
    "url": "https://github.com/Reyofficial77/OnyXCode/issues"
  },
  "bin": {
    "onyx": "dist/cli/main.js",
    "onyxcode": "dist/cli/main.js"
  },
  "main": "dist/cli/main.js",
  "exports": {
    ".": "./dist/cli/main.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "tui",
    "terminal"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "start": "node dist/cli/main.js",
    "pack:check": "npm pack --dry-run",
    "release": "npm run typecheck && npm run test && npm run build && npm publish"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "ignore": "^7.0.14",
    "marked": "^18.1.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@opentui/core": "^0.6.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
